+/* op 3: make one directory (parents must exist; list them first). Like mkdir1at(). */
+static int
+mkdir_one(const char *path, const struct d2s_file_rec *r)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct nameidata nd;
+	struct vnode_attr va;
+	vnode_t dvp, vp = NULLVP;
+	int err;
+
+	NDINIT(&nd, CREATE, OP_MKDIR, LOCKPARENT | AUDITVNPATH1, UIO_SYSSPACE,
+	    CAST_USER_ADDR_T(path), ctx);
+	nd.ni_cnd.cn_flags |= WILLBEDIR;
+	err = namei(&nd);
+	if (err) {
+		return err;
+	}
+	dvp = nd.ni_dvp;
+	if (nd.ni_vp != NULLVP) {
+		err = EEXIST;
+	} else {
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_type, VDIR);
+		VATTR_SET(&va, va_mode, r->mode & 07777);
+		VATTR_SET(&va, va_uid, r->uid);
+		VATTR_SET(&va, va_gid, r->gid);
+		err = vn_create(dvp, &vp, &nd, &va, 0, 0, NULL, ctx);
+	}
+	nameidone(&nd);
+	if (vp != NULLVP) {
+		vnode_put(vp);
+	}
+	if (nd.ni_vp != NULLVP) {
+		vnode_put(nd.ni_vp);
+	}
+	vnode_put(dvp);
+	return err;
+}
